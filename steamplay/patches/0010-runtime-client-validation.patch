+// The resolver repeatedly asks for boundaries in the same image. The index
+// exists only for that batch and is private to the resolving thread.
+static _Thread_local struct {
+    const struct mach_header_64 *image;
+    intptr_t slide;
+    uintptr_t *starts;
+    size_t count;
+} bounds_index;
+
+void np_end_bounds_batch(void) {
+    free(bounds_index.starts);
+    bounds_index.starts = NULL;
+    bounds_index.image = NULL;
+    bounds_index.count = 0;
+}
+
+void np_begin_bounds_batch(const struct mach_header_64 *mh, intptr_t slide) {
+    np_end_bounds_batch();
+    size_t bytes = 0;
+    const uint8_t *p = fn_starts_table(mh, slide, &bytes);
+    // Cap the optional allocation. The streaming lookup remains available.
+    if (!p || bytes > 1024 * 1024) return;
+    uintptr_t *starts = malloc(bytes * sizeof(*starts));
+    if (!starts) return;
+    const uint8_t *end = p + bytes;
+    uintptr_t va = (uintptr_t)mh;
+    size_t count = 0;
+    while (p < end) {
+        uintptr_t delta = 0;
+        unsigned shift = 0;
+        uint8_t octet;
+        do {
+            if (p == end || shift >= sizeof(delta) * 8) goto invalid;
+            octet = *p++;
+            uintptr_t digit = octet & 0x7fu;
+            if (digit > (UINTPTR_MAX >> shift)) goto invalid;
+            delta |= digit << shift;
+            shift += 7;
+        } while (octet & 0x80u);
+        if (!delta) {
+            bounds_index.image = mh;
+            bounds_index.slide = slide;
+            bounds_index.starts = starts;
+            bounds_index.count = count;
+            return;
+        }
+        if (delta > UINTPTR_MAX - va) goto invalid;
+        va += delta;
+        starts[count++] = va;
+    }
+invalid:
+    free(starts);
+}
+
