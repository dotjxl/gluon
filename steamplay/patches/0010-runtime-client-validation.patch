+    if (bounds_index.image == mh && bounds_index.slide == slide) {
+        size_t lo = 0, hi = bounds_index.count;
+        while (lo < hi) {
+            size_t mid = lo + (hi - lo) / 2;
+            if (bounds_index.starts[mid] <= addr) lo = mid + 1;
+            else hi = mid;
+        }
+        if (!lo || lo == bounds_index.count) return -1;
+        *out_start = bounds_index.starts[lo - 1];
+        *out_end = bounds_index.starts[lo];
+        return 0;
+    }
+
 
