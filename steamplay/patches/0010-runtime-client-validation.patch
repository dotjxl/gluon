+// Resolve the structure offsets and routes before writing any client hook.
+static int inside_text(uintptr_t address, uintptr_t text, size_t size, size_t before, size_t after) {
+    return address >= text && address - text >= before && after <= size &&
+           address - text <= size - after;
+}
+
+int gluon_preflight(const struct mach_header_64 *mh, intptr_t slide, np_resolve_result_t *resolved) {
+    uintptr_t text;
+    size_t size;
+    if (np_find_section(mh, slide, "__TEXT", "__text", &text, &size) != 0) return 0;
+    uintptr_t appid_gate = np_lookup_address(resolved, "CCompatManager::ResolveCompatToolForApp.local_redirect");
+    uintptr_t oslist_gate = np_lookup_address(resolved, "CCompatManager::GetOSListOverrideForApp.oslist_gate");
+    uintptr_t enabled = np_lookup_address(resolved, "CCompatManager::BIsCompatibilityToolEnabled");
+    uintptr_t mapping = np_lookup_address(resolved, "CCompatManager::GetWildcardMapping");
+    uintptr_t lookup = np_lookup_address(resolved, "CCompatManager::WindowsOnlyLookup");
+    uintptr_t tool_fn_start, tool_fn_end;
+    if (!inside_text(appid_gate, text, size, 0, 8) ||
+        !inside_text(oslist_gate, text, size, 0x40, 0x24) ||
